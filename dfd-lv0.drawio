        <mxCell id="f_o2" value="แดชบอร์ดสถิติ, รายงาน GAP มกษ. 9001 (แยกตาม batch_id), กลุ่มลูกค้า K-Means" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#0F766E;strokeWidth=1.6;fontFamily=Tahoma;fontSize=10.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_0" target="ext_owner">
