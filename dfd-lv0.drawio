        <mxCell id="ext_customer" value="&lt;b&gt;ลูกค้าสมาชิก LINE OA&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#334155;'&gt;(customers / LINE LIFF &amp;amp; Chatbot)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E40AF;strokeWidth=2;fontFamily=Tahoma;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;" vertex="1" parent="1">
