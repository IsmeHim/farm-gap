        <mxCell id="f_c1" value="สั่งซื้อผ่าน LINE LIFF / In-Chat, สลิปโอนเงิน (slip_image_url), ข้อความแชท AI, สแกน QR (/trace/:lot)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#1E40AF;strokeWidth=1.6;fontFamily=Tahoma;fontSize=10.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ext_customer" target="proc_0">
