        <mxCell id="f_f1" value="เตรียมดิน/เพาะกล้า (crop_activities), ปุ๋ย/สารเคมี (chemical_logs), โรคแมลง (pest_logs), เก็บเกี่ยว (harvest_logs)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=1.6;fontFamily=Tahoma;fontSize=10.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ext_farmer" target="proc_0">
