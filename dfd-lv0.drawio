        <mxCell id="f_f2" value="รหัสรอบปลูก (batch_code), แจ้งเตือนล็อกเก็บเกี่ยว (phi_days), รหัสล็อต (lot_code) &amp;amp; QR Code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=1.6;fontFamily=Tahoma;fontSize=10.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proc_0" target="ext_farmer">
