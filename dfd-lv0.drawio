        <mxCell id="f_o1" value="ข้อมูลแปลง/แคร่ (plots), ชนิดผัก (crops), อนุมัติคำสั่งซื้อ, บันทึกต้นทุน (cost_logs)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#166534;strokeWidth=1.6;fontFamily=Tahoma;fontSize=10.5;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ext_owner" target="proc_0">
          <mxGeometry relative="1" as="geometry">
