        <mxCell id="uc01" parent="sys_boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#0f172a;" value="UC01: จัดการแปลงและแคร่ปลูก&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #64748b;&quot;&gt;(Manage Plots &amp; Raised Beds)&lt;/font&gt;" vertex="1">
